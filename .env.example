# Preencher com o domínio oficial quando existir.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001

# Endpoint público de leitura do Palace Menu Studio (opcional).
# Sem configuração, é apresentada a carta de referência, claramente identificada.
# PALACE_MENU_FEED_URL=https://menu.example.com/api/published-menu

# Backend do Palace Studio. Em produção, utilizar o URL HTTPS definitivo.
PALACE_STUDIO_URL=http://127.0.0.1:3000
# O mesmo segredo privado configurado no Studio, com pelo menos 32 caracteres.
# Nunca expor com NEXT_PUBLIC_ nem guardar credenciais no código.
PALACE_RESERVATION_SECRET=
# Activar apenas atrás de um proxy confiável que substitua X-Forwarded-For.
PALACE_TRUST_PROXY=0
